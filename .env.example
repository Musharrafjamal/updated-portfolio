# Server-only Gmail SMTP configuration for the portfolio contact form.
# Copy this file to .env.local for local use; keep real secrets out of Git.
# EMAIL_USER: the Google account used to send and receive contact messages.
EMAIL_USER=
# EMAIL_PASS: a Google App Password, not your normal account password.
# Help: https://support.google.com/accounts/answer/185833?hl=en
EMAIL_PASS=
